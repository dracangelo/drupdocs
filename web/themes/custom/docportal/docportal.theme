<?php

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_page_attachments_alter().
 * Pass user data to JS for topbar/sidebar rendering.
 */
function docportal_page_attachments_alter(array &$attachments) {
  $current_user = \Drupal::currentUser();

  if ($current_user->isAuthenticated()) {
    $user = \Drupal\user\Entity\User::load($current_user->id());

    $user_name = $current_user->getAccountName();
    $is_admin = $current_user->hasRole('administrator');

    // Get country field
    $country = '';
    if ($user->hasField('field_country') && !$user->get('field_country')->isEmpty()) {
      $term = $user->get('field_country')->entity;
      if ($term) {
        $country = $term->getName();
      }
    }

    $attachments['#attached']['drupalSettings']['docportal'] = [
      'userName'    => $user_name,
      'userCountry' => $country,
      'isAdmin'     => $is_admin,
    ];
  }
}

/**
 * Implements hook_preprocess_node().
 */
function docportal_preprocess_node(&$variables) {
  $variables['attributes']['class'][] = 'docportal-node';
}

/**
 * Implements hook_preprocess_page().
 * Add login card wrapper on login page.
 */
function docportal_preprocess_page(&$variables) {
  $route = \Drupal::routeMatch()->getRouteName();
  $variables['is_login_page'] = in_array($route, [
    'user.login',
    'user.pass',
    'user.register',
  ]);
}
